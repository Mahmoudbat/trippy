rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function validPlace() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','name','arabicName','region','regionCity','category','description','whyVisit','tags','perfectFor','bestTime','recommendedDuration','coordinates','rating'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 160
        && d.arabicName is string && d.arabicName.size() <= 160
        && d.description is string && d.description.size() <= 5000
        && d.whyVisit is string && d.whyVisit.size() <= 5000
        && d.category in ['Culture','Religion','Adventure','Nature','Wellness']
        && d.region in ['North Jordan','Central Jordan','South Jordan']
        && d.tags is list && d.tags.size() <= 20
        && d.perfectFor is list && d.perfectFor.size() <= 20
        && d.coordinates.lat is number && d.coordinates.lat >= 29 && d.coordinates.lat <= 34
        && d.coordinates.lng is number && d.coordinates.lng >= 34 && d.coordinates.lng <= 40
        && (d.rating == null || (d.rating is number && d.rating >= 0 && d.rating <= 5));
    }
    match /places/{placeId} {
      allow read: if true;
      allow create, update: if admin() && request.resource.data.id == placeId && validPlace();
      allow delete: if admin();
    }
    match /admins/{uid} {
      // Grant roles only through the trusted Firebase Console, never through this website.
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /users/{uid}/journey/{placeId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && exists(/databases/$(database)/documents/places/$(placeId))
        && request.resource.data.keys().hasAll(['favorite','visited','visitedAt','memory','updatedAt'])
        && request.resource.data.keys().hasOnly(['favorite','visited','visitedAt','memory','updatedAt'])
        && request.resource.data.favorite is bool
        && request.resource.data.visited is bool
        && request.resource.data.visitedAt is string
        && request.resource.data.visitedAt.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && request.resource.data.memory is string
        && request.resource.data.memory.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/profile/{profileId} {
      allow read, delete: if owner(uid) && profileId == 'preferences';
      allow create, update: if owner(uid)
        && profileId == 'preferences'
        && request.resource.data.keys().hasAll(['interests','days','pace','region','updatedAt'])
        && request.resource.data.keys().hasOnly(['interests','days','pace','region','updatedAt'])
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 8
        && request.resource.data.days is int
        && request.resource.data.days >= 1
        && request.resource.data.days <= 7
        && request.resource.data.pace in ['relaxed','balanced','full']
        && request.resource.data.region in ['Any region','North Jordan','Central Jordan','South Jordan']
        && request.resource.data.updatedAt == request.time;
    }
    function validDay(day) {
      return day is map && day.keys().hasOnly(['stops']) && day.stops is list
        && day.stops.size() >= 1 && day.stops.size() <= 3
        && day.stops[0] is string && day.stops[0].size() <= 80
        && (day.stops.size() < 2 || (day.stops[1] is string && day.stops[1].size() <= 80))
        && (day.stops.size() < 3 || (day.stops[2] is string && day.stops[2].size() <= 80));
    }
    function validTrip() {
      let d = request.resource.data;
      return d.keys().hasOnly(['version','days','ownerId','updatedAt'])
        && d.version == 1 && owner(d.ownerId) && d.updatedAt == request.time
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 7
        && validDay(d.days[0])
        && (d.days.size() < 2 || validDay(d.days[1]))
        && (d.days.size() < 3 || validDay(d.days[2]))
        && (d.days.size() < 4 || validDay(d.days[3]))
        && (d.days.size() < 5 || validDay(d.days[4]))
        && (d.days.size() < 6 || validDay(d.days[5]))
        && (d.days.size() < 7 || validDay(d.days[6]));
    }
    match /users/{uid}/trips/{tripId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validTrip();
    }
    match /sharedPlans/{tripId} {
      allow get: if true;
      allow list: if false;
      allow create: if validTrip();
      allow update: if owner(resource.data.ownerId) && validTrip();
      allow delete: if request.auth != null
        && (!exists(/databases/$(database)/documents/sharedPlans/$(tripId)) || owner(resource.data.ownerId));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
